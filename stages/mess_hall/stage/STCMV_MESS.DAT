; STCMV_MESS.DAT — Mess Hall Stage Geometry Data (source / annotated text form)
; Compile with mgs1-stagecomp to produce the binary DAT for injection.
;
; Coordinate system: X = east(+)/west(-), Y = up(+), Z = south(+)/north(-)
; All units in metres.  Textures reference mess_walls.TIM and mess_props.TIM.

;===========================================================================
; SECTION 0 — FLOOR GEOMETRY
;===========================================================================
[MESH_FLOOR]
; Single large quad covering the whole room
QUAD  (-12.0, 0.0,  -8.0)  (12.0, 0.0,  -8.0)
      ( 12.0, 0.0,   8.0)  (-12.0, 0.0,  8.0)
  TEX  mess_walls.TIM  TILE  0x00  ; concrete floor tile
  COL_FLAGS  WALKABLE | SOLID

;===========================================================================
; SECTION 1 — CEILING
;===========================================================================
[MESH_CEILING]
QUAD  (-12.0, 3.5,  -8.0)  (12.0, 3.5,  -8.0)
      ( 12.0, 3.5,   8.0)  (-12.0, 3.5,  8.0)
  TEX  mess_walls.TIM  TILE  0x01  ; dropped ceiling panel
  COL_FLAGS  SOLID | NO_WALK

;===========================================================================
; SECTION 2 — WALLS
;===========================================================================
[MESH_WALLS]
; North wall (kitchen side)
QUAD  (-12.0, 0.0,  8.0)   (12.0, 0.0,  8.0)
      ( 12.0, 3.5,  8.0)   (-12.0, 3.5, 8.0)
  TEX  mess_walls.TIM  TILE  0x02  ; painted cinder block
  COL_FLAGS  SOLID

; South wall — two panels around exits
QUAD  (-12.0, 0.0, -8.0)   (-2.0,  0.0, -8.0)
      ( -2.0, 3.5, -8.0)   (-12.0, 3.5, -8.0)
  TEX  mess_walls.TIM  TILE  0x02
  COL_FLAGS  SOLID

QUAD  (  2.0, 0.0, -8.0)   (12.0,  0.0, -8.0)
      ( 12.0, 3.5, -8.0)   (  2.0, 3.5, -8.0)
  TEX  mess_walls.TIM  TILE  0x02
  COL_FLAGS  SOLID

; West wall — one panel around exit
QUAD  (-12.0, 0.0,  -8.0)  (-12.0, 0.0, -5.5)
      (-12.0, 3.5,  -5.5)  (-12.0, 3.5, -8.0)
  TEX  mess_walls.TIM  TILE  0x02
  COL_FLAGS  SOLID

QUAD  (-12.0, 0.0,  -4.5)  (-12.0, 0.0,  8.0)
      (-12.0, 3.5,   8.0)  (-12.0, 3.5, -4.5)
  TEX  mess_walls.TIM  TILE  0x02
  COL_FLAGS  SOLID

; East wall — one panel around exit
QUAD  (12.0, 0.0,  -8.0)   (12.0, 0.0, -5.5)
      (12.0, 3.5,  -5.5)   (12.0, 3.5, -8.0)
  TEX  mess_walls.TIM  TILE  0x02
  COL_FLAGS  SOLID

QUAD  (12.0, 0.0,  -4.5)   (12.0, 0.0,  8.0)
      (12.0, 3.5,   8.0)   (12.0, 3.5, -4.5)
  TEX  mess_walls.TIM  TILE  0x02
  COL_FLAGS  SOLID

;===========================================================================
; SECTION 3 — KITCHEN COUNTER (north, raised platform)
;===========================================================================
[MESH_KITCHEN]
; Counter top surface
QUAD  (-10.0, 0.95,  6.5)   (10.0, 0.95,  6.5)
      ( 10.0, 0.95,  7.8)   (-10.0, 0.95, 7.8)
  TEX  mess_props.TIM  TILE  0x10  ; stainless counter
  COL_FLAGS  WALKABLE | SOLID | LEDGE

; Counter front face
QUAD  (-10.0, 0.0,   6.5)   (10.0, 0.0,   6.5)
      ( 10.0, 0.95,  6.5)   (-10.0, 0.95, 6.5)
  TEX  mess_props.TIM  TILE  0x11  ; counter fascia
  COL_FLAGS  SOLID

;===========================================================================
; SECTION 4 — DINING TABLES (9 total, 3 rows of 3)
; Each table: 1.6m x 0.8m, height 0.76m
; Benches: 1.6m x 0.3m, height 0.45m, 0.55m offset from table edge
;===========================================================================
[MESH_TABLES]

; --- Row A (z = 4.5) ---
TABLE_MESH  (-8.0, 0.0,  4.5)   ; TABLE_A1
TABLE_MESH  ( 0.0, 0.0,  4.5)   ; TABLE_A2
TABLE_MESH  ( 8.0, 0.0,  4.5)   ; TABLE_A3

; --- Row B (z = 1.5) ---
TABLE_MESH  (-8.0, 0.0,  1.5)   ; TABLE_B1
TABLE_MESH  ( 0.0, 0.0,  1.5)   ; TABLE_B2
TABLE_MESH  ( 8.0, 0.0,  1.5)   ; TABLE_B3

; --- Row C (z = -1.5) ---
TABLE_MESH  (-8.0, 0.0, -1.5)   ; TABLE_C1
TABLE_MESH  ( 0.0, 0.0, -1.5)   ; TABLE_C2
TABLE_MESH  ( 8.0, 0.0, -1.5)   ; TABLE_C3

; TABLE_MESH macro expands to:
;   Top quad, 4 side quads, 2 bench quads (north+south), bench legs
;   All using mess_props.TIM TILE 0x12 (table surface), 0x13 (metal leg)

;===========================================================================
; SECTION 5 — FOOD TRAYS (decorative, on counter and 3 tables)
;===========================================================================
[MESH_PROPS]
; Stacked trays on counter
PROP  TRAY_STACK   (-4.0, 0.95,  7.0)   mess_props.TIM  0x20
PROP  TRAY_STACK   ( 4.0, 0.95,  7.0)   mess_props.TIM  0x20
; Single trays on occupied tables (imply recent meal)
PROP  TRAY_SINGLE  (-8.0, 0.76,  4.5)   mess_props.TIM  0x21
PROP  TRAY_SINGLE  ( 0.0, 0.76,  1.5)   mess_props.TIM  0x21
PROP  TRAY_SINGLE  ( 8.0, 0.76, -1.5)   mess_props.TIM  0x21

;===========================================================================
; SECTION 6 — EXIT DOOR FRAMES
;===========================================================================
[MESH_DOORS]
; West exit door frame
DOOR_FRAME  (-12.0, 0.0, -6.5)  WIDTH f2.5  HEIGHT f2.5  AXIS_X  mess_walls.TIM  0x03
; East exit door frame
DOOR_FRAME  ( 12.0, 0.0, -6.5)  WIDTH f2.5  HEIGHT f2.5  AXIS_X  mess_walls.TIM  0x03
; South exits (two smaller service doors)
DOOR_FRAME  ( -1.25, 0.0, -8.0) WIDTH f2.5  HEIGHT f2.5  AXIS_Z  mess_walls.TIM  0x03
